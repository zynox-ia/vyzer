# Copie para .env (gitignored) e troque as senhas: cp .env.example .env
COMPOSE_PROJECT_NAME=zynox
DOMAIN=zynox.localhost

POSTGRES_USER=zynox
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zynox

REDIS_PASSWORD=change-me

# RustFS (local S3-compatible object storage). Replace both credentials before exposing it.
RUSTFS_ACCESS_KEY=change-me-rustfs-access
RUSTFS_SECRET_KEY=change-me-rustfs-secret
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_BUCKET=zynox-assets

# API (apps/api). Mesmos usuário, senha e banco do Postgres acima.
DATABASE_URL=postgres://zynox:change-me@127.0.0.1:5432/zynox
API_PORT=3001
APP_BASE_URL=http://zynox.localhost
# Generate a high-entropy value, for example: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
