# Copie para .env (gitignored) e troque as senhas: cp .env.example .env
COMPOSE_PROJECT_NAME=vyzer
DOMAIN=vyzer.localhost

POSTGRES_USER=vyzer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vyzer

REDIS_PASSWORD=change-me

# RustFS (local S3-compatible object storage). Replace both credentials before exposing it.
RUSTFS_ACCESS_KEY=change-me-rustfs-access
RUSTFS_SECRET_KEY=change-me-rustfs-secret
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_BUCKET=vyzer-assets

# API (apps/api). Mesmos usuário, senha e banco do Postgres acima.
DATABASE_URL=postgres://vyzer:change-me@127.0.0.1:5432/vyzer
API_PORT=3001
