{
  "name": "vyzer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "db:generate": "pnpm --filter @vyzer/db generate",
    "db:migrate": "pnpm --filter @vyzer/db migrate",
    "build": "pnpm -r --if-present build",
    "check": "pnpm check:format && pnpm check:lint && pnpm check:types",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint --deny-warnings .",
    "check:types": "pnpm -r check:types",
    "fix": "oxfmt . && oxlint --fix .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0"
}
